{
  "name": "ledgerline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-led financial reconciliation workspace",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && vite build --config vite.worker.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "npm run typecheck && npm test && npm run build",
    "preview": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "db:migrate": "wrangler d1 migrations apply ledgerline --local",
    "db:migrate:remote": "wrangler d1 migrations apply ledgerline --remote"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-table": "^8.21.0",
    "hono": "^4.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@hono/vite-build": "^1.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "wrangler": "^4.45.0"
  }
}
